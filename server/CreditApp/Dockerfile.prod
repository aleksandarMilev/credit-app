FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080
EXPOSE 8081
ENV ASPNETCORE_URLS=http://+:8080
RUN useradd -m appuser
USER appuser

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["server/CreditApp/CreditApp.csproj", "server/CreditApp/"]
RUN dotnet restore "server/CreditApp/CreditApp.csproj"
COPY server/ server/
WORKDIR "/src/server/CreditApp"
RUN dotnet publish "CreditApp.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "CreditApp.dll"]